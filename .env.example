# Örnek ortam değişkenleri. Kopyala: cp .env.example .env
# Uygulama başlangıçta bu değerleri yükler ve DOĞRULAR (fail-fast).

# --- Uygulama ---
APP_NAME=ZATRANO
APP_ENV=development                 # development | staging | production
APP_VERSION=dev
APP_SHUTDOWN_TIMEOUT=15s

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_BODY_LIMIT_BYTES=4194304       # 4MB
HTTP_REQUEST_TIMEOUT=30s
HTTP_CORS_ALLOW_ORIGIN=*

# --- Veritabanı (pgxpool) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=enterprise
DB_SSLMODE=disable                  # production'da 'require' veya üstü zorunlu
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_QUERY_TIMEOUT=5s
DB_CONNECT_TIMEOUT=5s

# --- Kimlik doğrulama / JWT ---
AUTH_JWT_SECRET=change-me-in-production-please-32b   # production'da >=32 karakter
# MFA TOTP secret alan şifrelemesi: `openssl rand -base64 32`
AUTH_MFA_ENCRYPTION_KEY=
AUTH_JWT_ISSUER=enterprise
AUTH_JWT_AUDIENCE=zatrano-api
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m
# Tek kullanımlık token ömürleri (e-posta doğrulama / şifre sıfırlama)
AUTH_VERIFY_TOKEN_TTL=24h
AUTH_RESET_TOKEN_TTL=1h
# E-posta bağlantılarının (doğrulama/sıfırlama) kök adresi
AUTH_EMAIL_LINK_BASE_URL=http://localhost:8080

# --- OAuth / SSO (kimlik bilgisi boşsa sağlayıcı / butonlar devre dışı) ---
# Google Console callback (web): http://localhost:8080/auth/oauth/google/callback
# Google Console callback (API): http://localhost:8080/api/v1/auth/oauth/google/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:8080/api/v1/auth/oauth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Güvenlik ---
SEC_RATE_LIMIT_MAX=100
SEC_RATE_LIMIT_WINDOW=1m
SEC_MAX_UPLOAD_BYTES=10485760       # 10MB
SEC_ALLOWED_UPLOAD_MIME=image/jpeg,image/png,application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel
SEC_TRUSTED_PROXIES=

# Cloudflare Turnstile (public formlar: iletişim, giriş, kayıt vb.)
# Production'da zorunlu. Development'ta boş bırakılırsa doğrulama devre dışı kalır.
SEC_TURNSTILE_SITE_KEY=
SEC_TURNSTILE_SECRET_KEY=

# --- Çoklu dil (i18n) ---
I18N_DEFAULT_LOCALE=tr              # DEFAULT_LOCALE, SUPPORTED içinde olmalı
I18N_SUPPORTED=tr,en               # her dil için pkg/i18n/locales/<locale>.json gerekir

# --- SMTP (gerçek e-posta). Production'da HOST+FROM zorunlu.
# Boş bırakılırsa LogMailer kullanılır (yalnızca log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls             # none | starttls | tls
SMTP_TIMEOUT=15s

# --- İletişim formu alıcısı (production'da zorunlu) ---
CONTACT_RECIPIENT_EMAIL=

# --- Merkezi bildirim sistemi ---
# Aktif SMS sağlayıcısı dashboard'dan seçilir (Ayarlar → SMS). Varsayılan: netgsm.
NOTIFY_SMS_FROM=                   # Mesaj başlığı (Netgsm msgheader / İleti Merkezi sender)
NOTIFY_NETGSM_USER=                # Netgsm abone numarası (850xxxxxxx, 312XXXXXXX vb.)
NOTIFY_NETGSM_PASSWORD=            # Alt kullanıcı (API Kullanıcısı) şifresi
NOTIFY_NETGSM_APPNAME=zatrano      # Netgsm appname parametresi
NOTIFY_NETGSM_ENCODING=TR          # UTF-8 | TR | UNICODE
NOTIFY_NETGSM_IYSFILTER=0          # 0 bilgilendirme | 11 bireysel ticari | 12 tacir ticari
NOTIFY_ILETIMERKEZI_KEY=           # İleti Merkezi API key
NOTIFY_ILETIMERKEZI_HASH=          # İleti Merkezi API hash (panelden üretilir)
NOTIFY_ILETIMERKEZI_IYS=0          # 0 sorgulama yok | 1 İYS sorgusu
NOTIFY_ILETIMERKEZI_IYS_LIST=BIREYSEL  # BIREYSEL | TACIR (IYS=1 ise zorunlu)

# Aktif ödeme sağlayıcısı dashboard'dan seçilir (Ayarlar → Ödeme). Varsayılan: iyzico.
# 3DS banka dönüş adresi (iyzico + Moka ortak). Boş bırakılırsa:
#   {AUTH_EMAIL_LINK_BASE_URL}/api/v1/payments/3ds/callback
# Web alternatif (aynı handler): POST /payments/3ds/callback
PAYMENT_CALLBACK_URL=
# Kart alanları DB şifreleme (AES-256-GCM, 32 bayt base64). Boşsa dev modunda düz metin.
# Üret: openssl rand -base64 32  |  production'da zorunlu
PAYMENT_FIELD_ENCRYPTION_KEY=
PAYMENT_IYZICO_API_KEY=
PAYMENT_IYZICO_SECRET_KEY=
PAYMENT_IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Iyzico Merchant Panel → Bildirimler (webhook, ayrı env yok — kök URL'den türetilir):
#   API: {AUTH_EMAIL_LINK_BASE_URL}/api/v1/payments/webhook/iyzico
#   Web: {AUTH_EMAIL_LINK_BASE_URL}/payments/webhook/iyzico
# X-IYZ-SIGNATURE-V3 doğrulaması PAYMENT_IYZICO_SECRET_KEY ile yapılır.
PAYMENT_MOKA_DEALER_CODE=
PAYMENT_MOKA_USERNAME=
PAYMENT_MOKA_PASSWORD=
PAYMENT_MOKA_BASE_URL=https://service.refmokaunited.com
PAYMENT_MOKA_SOFTWARE=zatrano
